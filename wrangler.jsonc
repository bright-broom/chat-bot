{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-bot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "chat-bot"
    }
  ],
  // Workers AI（LLM）。OPENROUTER_API_KEY を設定しない場合はこれで回答を生成する
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
  // 任意: OPENROUTER_API_KEY をシークレットに設定すると、Workers AI の代わりに OpenRouter（Web 検索つき）を使う
  // 任意の設定（WORKERS_AI_MODEL、RATE_LIMIT_PER_MINUTE など）は "vars" に書くか、ダッシュボードで変数として追加する
}
